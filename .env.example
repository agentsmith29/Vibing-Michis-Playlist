# Copy to .env and adjust. Never commit the .env file.

# Login for the web player (created on first start).
APP_USERNAME=admin
APP_PASSWORD=change-me-please

# Database password (internal only, but use something random).
POSTGRES_PASSWORD=change-me-too

# Folder with your mp3 files. The old player used ./html/michi-playlist/audio
MUSIC_DIR=./music

# Where the player is reachable. 127.0.0.1 = only this machine (recommended).
# Use 0.0.0.0 to allow other devices in your LAN, or put a reverse proxy in front.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=4000

# Host names the player is accessed by (comma separated), e.g. music.example.lan
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when served through HTTPS by another proxy, e.g. https://music.example.com
CSRF_TRUSTED_ORIGINS=
# Set to true when the player is only reached via HTTPS.
SECURE_COOKIES=false

# File owner of the music folder (run `id` on the host).
APP_UID=1000
APP_GID=1000

# Seconds between automatic scans of the music folder (0 = off).
LIBRARY_SCAN_INTERVAL=300
TZ=Europe/Berlin
